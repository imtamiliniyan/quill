# Firebase Admin SDK credentials — used by api/waitlist.js (Vercel serverless)
# Copy this file to .env.local for local development.
# NEVER commit .env.local or .env to git.
#
# Get these values from:
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
#   Download the JSON, then copy the three fields below.

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# Brevo Transactional Email Configuration (Optional - fallback to console log in local demo mode)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=waitlist@updates.quill.chat
BREVO_SENDER_NAME=Quill
