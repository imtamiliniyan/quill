<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparkle's update feed for Quill. SUFeedURL (Resources/Info.plist) points
  here via raw.githubusercontent.com on the `master` branch, so pushing a
  change to this file to master is what actually makes a new version
  visible to the app's automatic background check and "Check for
  Updates…" menu item — nothing else needs to change or redeploy.

  Newest <item> goes first. Generate one via scripts/release-appcast.sh
  after scripts/build-app.sh, then paste it in here by hand — reviewed
  before it's pushed, same discipline as the GitHub Releases themselves
  (see .github/workflows/release.yml's `draft: true` comment).

-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
    <channel>
        <title>Quill</title>
        <link>https://raw.githubusercontent.com/imtamiliniyan/quill/master/appcast.xml</link>
        <description>Update feed for Quill, a macOS dictation app.</description>
        <language>en</language>

        <item>
            <title>Quill 0.8.0</title>
            <pubDate>Thu, 20 Aug 2026 20:32:56 +0000</pubDate>
            <sparkle:version>5</sparkle:version>
            <sparkle:shortVersionString>0.8.0</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <link>https://github.com/imtamiliniyan/quill/releases/tag/v0.8.0</link>
            <description><![CDATA[
                <ul>
                    <li>Real auto-update: Quill can now find and install its own updates (Sparkle), replacing the old manual GitHub-check.</li>
                    <li>Remove Filler Words moved from Voice Engine to Style, next to Auto Cleanup.</li>
                    <li>Check for Updates now shows Quill's actual app icon instead of a generic checkmark.</li>
                </ul>
            ]]></description>
            <enclosure
                url="https://github.com/imtamiliniyan/quill/releases/download/v0.8.0/Quill-0.8.0.zip"
                type="application/octet-stream"
                sparkle:edSignature="jLL/+j0N9lnsgZrkYRvcDpy5XdpAPC7T0rAqbHezo8mZT7RSY5IstaMyrt2ntim2X0TO5TVgW1duwmGlwpiAAg=="
                length="10022234"
            />
        </item>
    </channel>
</rss>
